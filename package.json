{
  "name": "@microsoft/webui-benchmarks",
  "version": "0.0.0",
  "private": true,
  "description": "Canonical 15-row SSR and browser benchmark suite for WebUI and production framework peers.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/microsoft/webui-benchmarks.git"
  },
  "scripts": {
    "build": "node todo/runner/build.mjs",
    "build:todo": "node todo/runner/build.mjs",
    "test": "pnpm run test:javascript && pnpm run test:rust",
    "test:javascript": "node --test --test-concurrency=1 scripts/tests/*.test.mjs todo/shared/*.test.mjs todo/apps/*/tests/*.test.mjs todo/servers/tests/*.test.mjs todo/runner/tests/*.test.mjs todo/browser/tests/*.test.mjs",
    "test:rust": "cargo test --workspace --locked",
    "test:repository": "node --test scripts/tests/*.test.mjs",
    "test:todo:contract": "node --test todo/shared/*.test.mjs",
    "test:todo:apps": "node --test --test-concurrency=1 todo/apps/*/tests/*.test.mjs",
    "test:todo:servers": "node --test todo/servers/tests/*.test.mjs",
    "test:todo:runner": "node --test todo/runner/tests/*.test.mjs",
    "test:todo:browser": "node --test --test-concurrency=1 todo/browser/tests/*.test.mjs",
    "test:todo": "node --test --test-concurrency=1 todo/shared/*.test.mjs todo/apps/*/tests/*.test.mjs todo/servers/tests/*.test.mjs todo/runner/tests/*.test.mjs todo/browser/tests/*.test.mjs",
    "bench": "node todo/runner/cli.mjs",
    "bench:official": "node scripts/run-official-benchmarks.mjs",
    "bench:quick": "node todo/runner/cli.mjs --quick",
    "bench:json": "node todo/runner/cli.mjs --json",
    "bench:ssr:official": "node todo/runner/cli.mjs --runtime-mode official",
    "bench:ssr:save": "node todo/runner/cli.mjs --runtime-mode official",
    "bench:browser": "node todo/browser/cli.mjs",
    "bench:browser:official": "node todo/browser/cli.mjs --official --rounds 10 --headed",
    "bench:hydration-gate": "node todo/browser/hydration-gate.mjs",
    "preview:all": "node todo/browser/serve-all.mjs",
    "bench:todo": "node todo/runner/cli.mjs",
    "bench:todo:quick": "node todo/runner/cli.mjs --quick",
    "bench:todo:json": "node todo/runner/cli.mjs --json",
    "bench:todo:browser": "node todo/browser/cli.mjs",
    "export:summary": "node scripts/export-benchmark-summary.mjs",
    "export:webui": "node scripts/extract-webui-benchmarks.mjs",
    "profile:prepare": "node todo/profile/prepare.mjs",
    "verify:runtimes": "node todo/servers/verify-runtimes.mjs --official",
    "webui:configure": "node scripts/configure-webui.mjs",
    "webui:local": "node scripts/configure-webui.mjs --prepare --install",
    "webui:packed": "node scripts/configure-webui.mjs --packed --install",
    "webui:sync": "node scripts/configure-webui.mjs --sync",
    "webui:status": "node scripts/configure-webui.mjs --status",
    "webui:cargo": "node scripts/webui-cargo.mjs",
    "webui:release": "node scripts/configure-webui.mjs --release --install"
  },
  "engines": {
    "node": "24.19.0"
  },
  "packageManager": "pnpm@11.5.3",
  "dependencies": {
    "@microsoft/fast-element": "3.0.1",
    "@microsoft/webui": "0.0.27",
    "@microsoft/webui-framework": "0.0.27",
    "@microsoft/webui-router": "0.0.27",
    "@solidjs/router": "1.0.0",
    "@tanstack/react-router": "1.170.31",
    "@vue/server-renderer": "3.5.41",
    "autocannon": "8.0.0",
    "d3": "7.9.0",
    "d3-dsv": "3.0.1",
    "date-fns": "4.4.0",
    "immer": "11.1.18",
    "minisearch": "7.2.0",
    "preact": "10.29.8",
    "preact-iso": "2.12.2",
    "preact-render-to-string": "6.7.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.0",
    "rrule": "2.8.1",
    "solid-js": "1.9.14",
    "vue": "3.5.41",
    "vue-router": "4.6.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@vue/compiler-sfc": "3.5.41",
    "bun": "1.3.14",
    "deno": "2.9.5",
    "esbuild": "0.28.1",
    "esbuild-plugin-solid": "0.6.0",
    "typescript": "6.0.3"
  }
}
