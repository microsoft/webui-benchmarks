{
  "name": "todo-bench-sveltekit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "start": "node server.mjs"
  },
  "engines": {
    "node": "24.19.0"
  },
  "webuiBenchmark": {
    "schema": "webui.ssr-todo-app/v1",
    "id": "sveltekit",
    "buildOutput": "build/index.js",
    "frameworkPackages": [
      "@sveltejs/adapter-node",
      "@sveltejs/kit",
      "svelte",
      "vite"
    ],
    "productionEntry": "server.mjs",
    "productionArgs": [],
    "routes": {
      "cached": "/cached",
      "dynamic": "/dynamic"
    },
    "compression": false,
    "workerCount": 1
  }
}
