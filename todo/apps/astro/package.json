{
  "name": "todo-bench-astro",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "astro build",
    "start": "node dist/server/entry.mjs"
  },
  "engines": {
    "node": "26.12.0"
  },
  "webuiBenchmark": {
    "schema": "webui.ssr-todo-app/v1",
    "id": "astro",
    "buildOutput": "dist/server/entry.mjs",
    "frameworkPackages": [
      "@astrojs/node",
      "@astrojs/preact",
      "preact",
      "astro"
    ],
    "productionEntry": "dist/server/entry.mjs",
    "productionArgs": [],
    "routes": {
      "cached": "/cached",
      "dynamic": "/dynamic"
    },
    "compression": false,
    "workerCount": 1
  }
}
