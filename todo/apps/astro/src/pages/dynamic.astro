import TodoApp from "../components/todo-app.astro";
import WorkspaceLayout from "../layouts/workspace-layout.astro";
import { nextDynamicTodoState } from "../lib/server-state.mjs";

export const prerender = false;

Astro.response.headers.set(
  "cache-control",
  "no-store, no-cache, must-revalidate",
);
const initialState = nextDynamicTodoState();
---

<WorkspaceLayout title="Dynamic SSR · SSR Todo Benchmark">
  <TodoApp
    initialState={initialState}
    renderMode="dynamic"
  />
</WorkspaceLayout>
