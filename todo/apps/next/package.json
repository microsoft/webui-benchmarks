{
  "name": "todo-bench-next",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "start": "next start"
  },
  "engines": {
    "node": "24.19.0"
  },
  "webuiBenchmark": {
    "schema": "webui.ssr-todo-app/v1",
    "id": "next",
    "buildOutput": ".next",
    "frameworkPackages": [
      "next",
      "react",
      "react-dom"
    ],
    "productionEntry": "node_modules/next/dist/bin/next",
    "productionEntryBase": "workspace",
    "productionArgs": [
      "start",
      "--hostname",
      "{host}",
      "--port",
      "{port}"
    ],
    "routes": {
      "cached": "/cached",
      "dynamic": "/dynamic"
    },
    "compression": false,
    "workerCount": 1
  }
}
